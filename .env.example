# ---- Server ----
PORT=3000
# Public base URL of the deployed site (used for Stripe redirect URLs).
# Must match where the app is actually reachable (no trailing slash).
BASE_URL=http://localhost:3000

# Secret used to sign the unlock cookie. Set to a long random string in prod.
COOKIE_SECRET=change-me-to-a-long-random-string

# ---- Stripe ----
# REQUIRED to take payments. Get these from https://dashboard.stripe.com/apikeys
# Use the LIVE keys for real charges, TEST keys (sk_test_/pk_test_) while developing.
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# ---- Product / pricing ----
# Price in whole currency units (dollars). The design ships at 10.
PRICE_USD=10
CURRENCY=usd
PRODUCT_NAME=Resume Template

# ---- Deliverables (swappable without code changes) ----
# Editable Google Doc link the buyer gets (set "Anyone with link: Viewer", then
# buyers use File > Make a copy). Tip: a link ending in /copy forces the copy dialog.
GOOGLE_DOC_URL=https://docs.google.com/document/d/PLACEHOLDER_DOC_ID/edit?usp=sharing

# Path to the PDF that is served on download. Swap this file anytime.
TEMPLATE_PDF_PATH=./template/resume-template.pdf
# Filename the buyer's browser saves it as.
DOWNLOAD_FILENAME=EJ-Green-Resume-Template.pdf

# ---- Misc ----
INSTAGRAM_URL=https://instagram.com/cousin.ej
# Microsoft Clarity analytics. Clarity project > Settings > Overview. Leave blank to disable.
CLARITY_PROJECT_ID=
